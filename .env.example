# Salin menjadi .env.local lalu isi. Jangan pernah meng-commit .env.local.

# Supabase: Project Settings -> API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Kunci service_role. Hanya dipakai di server (lib/supabase-server.ts). Jangan dibagikan.
SUPABASE_SERVICE_ROLE_KEY=

# Kunci penandatangan sesi login (JWT HS256), minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Pakai nilai yang BERBEDA untuk lokal dan produksi.
SESSION_SECRET=
