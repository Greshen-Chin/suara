# Salin menjadi .env.local lalu isi. Jangan pernah meng-commit .env.local.

# Supabase: Project Settings -> API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Kunci service_role. Hanya dipakai di server (lib/supabase-server.ts). Jangan dibagikan.
SUPABASE_SERVICE_ROLE_KEY=

# Kunci penandatangan sesi login (JWT HS256), minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Pakai nilai yang BERBEDA untuk lokal dan produksi.
SESSION_SECRET=

# Saran urgensi dari AI (Gemini), opsional. Tanpa GEMINI_API_KEY fitur ini mati sepenuhnya dan tidak ada
# jejaknya di antarmuka. Buat kunci di https://aistudio.google.com/apikey (pembuat minimal 18 tahun) dan jangan
# menautkan akun penagihan bila ingin tetap di paket gratis. Jangan pernah meng-commit nilainya.
# Beranda diprerender: setelah memasang atau mencabut kunci, build dan deploy ulang supaya teksnya ikut berubah.
GEMINI_API_KEY=
# Model (bawaan gemini-3.5-flash-lite; belum dikalibrasi, lihat docs/saran-urgensi.md).
# GEMINI_MODEL=gemini-3.5-flash-lite
# Tingkat berpikir bila model mendukung: minimal | low | medium | high (kosong = bawaan model).
# GEMINI_THINKING=
# Hanya untuk uji E2E (server tiruan lokal). Alamat selain resmi atau http://127.0.0.1 / http://localhost diabaikan.
# GEMINI_BASE_URL=http://127.0.0.1:54399
